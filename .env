# Safio Backend Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safio_db
DB_USER=safio_user
DB_PASSWORD=your_secure_password

# API Keys
API_KEY_MAPS=your_maps_api_key
API_KEY_AI=your_ai_api_key

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Email Service
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Python ML Path
PYTHON_PATH=python
AI_SCRIPT_PATH=./ai_predictor.py

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/server.log
